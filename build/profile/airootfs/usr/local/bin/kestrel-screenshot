#!/usr/bin/env bash
set -euo pipefail
mkdir -p "$HOME/Pictures/Screenshots"
path="$HOME/Pictures/Screenshots/$(date +%Y%m%d-%H%M%S).png"
if [ "${1:-}" = region ]; then
 geometry=$(slurp) || exit 0
 grim -g "$geometry" "$path"
else
 grim "$path"
fi
# Like ChromeOS: keep a file and also put the image on the clipboard.
command -v wl-copy >/dev/null 2>&1 && wl-copy --type image/png < "$path" || true
notify-send 'Screenshot saved' "Copied to clipboard. $path"
