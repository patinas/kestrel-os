#!/usr/bin/env python3
"""Waybar launcher feedback; keep the existing press-to-open action."""
import json,os,subprocess,sys,time
from pathlib import Path
state=Path(os.environ.get('XDG_RUNTIME_DIR','/tmp'))/('kestrel-shelf-press-'+str(os.getuid()))
cmd=sys.argv[1] if len(sys.argv)>1 else 'watch'
if cmd=='press':
 state.write_text(str(time.monotonic()))
 subprocess.Popen(['kestrel-launcher'],start_new_session=True)
elif cmd=='release':
 was=state.exists();state.unlink(missing_ok=True)
elif cmd=='watch':
 last=None
 while True:
  try:active=time.monotonic()-float(state.read_text())<10
  except (OSError,ValueError):active=False
  if active!=last:print(json.dumps({'text':'\ue000','class':'pressed' if active else 'idle'}),flush=True);last=active
  time.sleep(.04)
else:sys.exit(1)
