#!/bin/sh
# Kestrel session launcher (replaces milestone 1 version): windowed desktop by default, gaming mode if requested.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WLR_NO_HARDWARE_CURSORS=1
if [ -n "$(systemd-detect-virt --vm 2>/dev/null | grep -v none)" ]; then
  export WLR_RENDERER=pixman LIBGL_ALWAYS_SOFTWARE=1
fi
[ -r /run/kestrel-gpu.env ] && { set -a; . /run/kestrel-gpu.env; set +a; }
# NVIDIA userspace for the whole session only when the NVIDIA card drives the display; on hybrid systems it stays an offload GPU (kestrel-prime-run).
if [ "$(cat /run/kestrel-gpu 2>/dev/null)" = nvidia-open ] && [ "${KESTREL_PRIMARY_VENDOR:-0x10de}" = 0x10de ]; then
  export GBM_BACKEND=nvidia-drm __GLX_VENDOR_LIBRARY_NAME=nvidia WLR_NO_HARDWARE_CURSORS=1
fi
# User must accept Google terms locally. No Chromium fallback is launched.
until /usr/local/bin/kestrel-chrome-setup; do
  printf 'Chrome setup failed or was declined. Check network. Press Enter to retry, or Ctrl+C to stop. '
  read reply
done
CHROME="$HOME/.local/share/kestrel/chrome/current/opt/google/chrome/chrome"
while true; do
  if [ -f "$HOME/.kestrel-mode" ]; then
    /usr/local/bin/kestrel-gaming-session
  else
    labwc -C /etc/kestrel/labwc
  fi
  sleep 1
done
