#!/usr/bin/env python3
import gi,subprocess,os
gi.require_version('Gtk','3.0')
from gi.repository import Gtk,Gio,Gdk,GLib
GLib.set_prgname('kestrel-launcher')
class Launcher(Gtk.Window):
 def __init__(self):
  super().__init__(title='Kestrel apps');self.set_default_size(640,480);self.set_resizable(False);self.set_keep_above(True)
  self.connect('destroy',Gtk.main_quit);self.connect('key-press-event',self.key)
  box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=16);box.set_border_width(8);self.add(box)
  title=Gtk.Label(label='Kestrel apps');box.pack_start(title,False,False,0)
  self.search=Gtk.SearchEntry();self.search.set_size_request(-1,56);self.search.set_placeholder_text('Search apps');box.pack_start(self.search,False,False,0)
  scroll=Gtk.ScrolledWindow();box.pack_start(scroll,True,True,0)
  self.grid=Gtk.FlowBox();self.grid.set_valign(Gtk.Align.START);self.grid.set_selection_mode(Gtk.SelectionMode.NONE);self.grid.set_min_children_per_line(5);self.grid.set_max_children_per_line(5);self.grid.set_row_spacing(16);self.grid.set_column_spacing(16);scroll.add(self.grid)
  self.items=[]
  basics=[('Browser','web-browser',['kestrel-browser']),('Mail','mail-unread',['kestrel-browser','https://mail.google.com']),('Video','video-x-generic',['kestrel-browser','https://www.youtube.com']),('Settings','preferences-system',['kestrel-browser','http://127.0.0.1:8765/#settings']),('Terminal (advanced)','utilities-terminal',['kestrel-terminal'])]
  for name,icon,args in basics:self.add_app(name,icon,lambda a=args:subprocess.Popen(a))
  # Chrome-created desktop entries retain their app-id/standalone-window command.
  for app in Gio.AppInfo.get_all():
   if app.should_show() and app.get_id().startswith('chrome-') and '--app-id=' in (app.get_commandline() or ''):self.add_app(app.get_display_name(),app.get_icon(),lambda a=app:a.launch([],None))
  self.grid.set_filter_func(lambda child:self.search.get_text().lower() in child.name.lower());self.search.connect('search-changed',lambda _:self.grid.invalidate_filter())
  self.show_all();self.search.grab_focus()
 def add_app(self,name,icon,fn):
  child=Gtk.FlowBoxChild();child.name=name;button=Gtk.Button();box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=8);box.set_size_request(96,120)
  image=Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG) if isinstance(icon,str) else Gtk.Image.new_from_gicon(icon,Gtk.IconSize.DIALOG);image.set_pixel_size(64)
  box.pack_start(image,True,True,0);label=Gtk.Label(label=name);label.set_line_wrap(True);box.pack_start(label,False,False,0);button.add(box);child.add(button);self.grid.add(child)
  def click(_):fn();self.close()
  button.connect('clicked',click)
 def key(self,_,event):
  if event.keyval==Gdk.KEY_Escape:self.close()
Gtk.Settings.get_default().set_property('gtk-icon-theme-name','Papirus')
provider=Gtk.CssProvider();provider.load_from_data(b'* {font-family: Noto Sans;font-size:14px;} window {background:#eef3fb;color:#233044;border-radius:16px;} button {background:#e2eaf6;border:1px solid #c2cee0;border-radius:16px;padding:8px;} button:hover {background:#cddcf1;} entry {border-radius:28px;padding:8px 16px;} button:focus {border-color:#4680bc;} button:active {background:#abc5e8;}')
Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(),provider,Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
Launcher();Gtk.main()
