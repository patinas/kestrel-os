#!/usr/bin/env python3
import getpass,hashlib,hmac,json,os,secrets,sys
from pathlib import Path
P=Path('/var/lib/kestrel/sudo-password')
if os.geteuid()!=0:sys.exit(1)
if sys.argv[1:] == ['set']:
 a=getpass.getpass('Choose advanced sudo password (at least 12 characters): ')
 b=getpass.getpass('Repeat password: ')
 if len(a)<12 or a!=b:print('Password too short or mismatch');sys.exit(1)
 salt=secrets.token_bytes(32)
 data={'salt':salt.hex(),'hash':hashlib.scrypt(a.encode(),salt=salt,n=16384,r=8,p=1).hex()}
 tmp=P.with_suffix('.tmp')
 fd=os.open(tmp,os.O_CREAT|os.O_TRUNC|os.O_WRONLY,0o600)
 with os.fdopen(fd,'w') as f:json.dump(data,f)
 os.replace(tmp,P)
 sys.exit(0)
if os.environ.get('PAM_USER')!='kestrel' or not Path('/var/lib/kestrel/terminal-enabled').exists():sys.exit(1)
try:
 d=json.loads(P.read_text());password=sys.stdin.buffer.read(512).rstrip(b'\0')
 actual=hashlib.scrypt(password,salt=bytes.fromhex(d['salt']),n=16384,r=8,p=1).hex()
 sys.exit(0 if hmac.compare_digest(actual,d['hash']) else 1)
except Exception:sys.exit(1)
