#!/bin/sh
# kestrel-mode gaming|desktop: set the next session type and restart the current compositor.
case "$1" in
  gaming) [ -x /usr/bin/steam ] || { echo "Steam was not selected at installation; gaming mode unavailable" >&2; exit 1; }; echo gaming > "$HOME/.kestrel-mode" ;;
  desktop) rm -f "$HOME/.kestrel-mode" ;;
  *) echo "usage: kestrel-mode gaming|desktop" >&2; exit 1 ;;
esac
uid=$(id -u)
pkill -u "$uid" -x labwc 2>/dev/null
pkill -u "$uid" -x gamescope 2>/dev/null
exit 0
