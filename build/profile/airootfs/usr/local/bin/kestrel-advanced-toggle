#!/usr/bin/env bash
set -euo pipefail
[ "$EUID" = 0 ] && [ "${SUDO_USER:-}" = kestrel ] || exit 1
D=/var/lib/kestrel
mkdir -p "$D"; chmod 755 "$D"
case "${1:-}" in
 enable)
   printf 'Advanced terminal access allows system changes. Choose a non-empty local password.\n'
   /usr/local/bin/kestrel-sudo-password set
   printf 'kestrel ALL=(ALL:ALL) ALL\n' > "$D/sudoers"
   chmod 440 "$D/sudoers"
   touch "$D/terminal-enabled";;
 disable)
   printf '# Advanced access disabled\n' > "$D/sudoers"
   chmod 440 "$D/sudoers"
   rm -f "$D/terminal-enabled" "$D/sudo-password"
   sudo -K || true
   pkill -u kestrel -x foot || true;;
 *) exit 2;;
esac
