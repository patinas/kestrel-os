"$HOME/.local/share/kestrel/chrome/current/opt/google/chrome/chrome" --kiosk --no-first-run --no-default-browser-check --ozone-platform=wayland --user-data-dir="$HOME/.config/kestrel-chrome" --app=http://127.0.0.1:8765
