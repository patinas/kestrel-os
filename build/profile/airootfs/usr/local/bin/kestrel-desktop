#!/usr/bin/env bash
/usr/local/bin/kestrel-shell-server &
# BlueZ pairing agent and graphical device manager. No terminal or secret logs.
blueman-applet >/dev/null 2>&1 &
# Notification daemon: notify-send (screenshots etc.) had no receiver before.
mako >/dev/null 2>&1 &
/usr/local/bin/kestrel-idle >/dev/null 2>&1 &
swaybg -i /usr/share/kestrel/wallpaper.png -m fill &
if [ -e /dev/virtio-ports/kestrel-ci-check ]; then socat TCP-LISTEN:9233,bind=0.0.0.0,reuseaddr,fork TCP:127.0.0.1:9222 & fi
mkdir -p "$HOME/.local/state/kestrel"
fc-cache -f /usr/share/fonts/kestrel
# Grouped taskbar (one icon per app) needs pywayland; fall back to plain per-window buttons.
WB=/etc/kestrel/waybar/config-plain.json
if python3 -c 'import pywayland' 2>/dev/null; then WB=/etc/kestrel/waybar/config.json; /usr/local/bin/kestrel-taskbar daemon >"$HOME/.local/state/kestrel/taskbar.log" 2>&1 & fi
waybar -c "$WB" -s /etc/kestrel/waybar/style.css >"$HOME/.local/state/kestrel/waybar.log" 2>&1 &
/usr/local/bin/kestrel-browser &
wait
