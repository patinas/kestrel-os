<labwc_config>
 <core><decoration>server</decoration></core>
 <theme><name>Clearlooks-3.4</name><titleLayout>icon:iconify,max,close</titleLayout><showTitle>yes</showTitle><cornerRadius>12</cornerRadius></theme>
 <keyboard><default />
  <keybind key="W-Return"><action name="Execute" command="/usr/local/bin/kestrel-terminal" /></keybind>
  <keybind key="W-space"><action name="Execute" command="/usr/local/bin/kestrel-launcher" /></keybind>
 <keybind key="A-S-s"><action name="Execute" command="/usr/local/bin/kestrel-quick-settings" /></keybind>
 <keybind key="W-b"><action name="Execute" command="/usr/local/bin/kestrel-browser" /></keybind>
  <keybind key="A-F9"><action name="Iconify" /></keybind>
  <keybind key="A-F10"><action name="ToggleMaximize" /></keybind>
 <keybind key="Super_L" onRelease="yes"><action name="Execute" command="/usr/local/bin/kestrel-launcher" /></keybind>
<keybind key="A-equal"><action name="ToggleMaximize" /></keybind>
<keybind key="A-minus"><action name="Iconify" /></keybind>
<keybind key="A-bracketleft"><action name="SnapToEdge" direction="left" /></keybind>
<keybind key="A-bracketright"><action name="SnapToEdge" direction="right" /></keybind>
<keybind key="C-F5"><action name="Execute" command="kestrel-screenshot" /></keybind>
<keybind key="C-S-F5"><action name="Execute" command="kestrel-screenshot region" /></keybind>
<keybind key="XF86AudioRaiseVolume"><action name="Execute" command="kestrel-media up" /></keybind>
<keybind key="XF86AudioLowerVolume"><action name="Execute" command="kestrel-media down" /></keybind>
<keybind key="XF86AudioMute"><action name="Execute" command="kestrel-media mute" /></keybind>
<keybind key="XF86AudioPlay"><action name="Execute" command="kestrel-media play" /></keybind>
<keybind key="XF86AudioNext"><action name="Execute" command="kestrel-media next" /></keybind>
<keybind key="XF86AudioPrev"><action name="Execute" command="kestrel-media previous" /></keybind>
<keybind key="XF86MonBrightnessUp"><action name="Execute" command="kestrel-media bright-up" /></keybind>
<keybind key="XF86MonBrightnessDown"><action name="Execute" command="kestrel-media bright-down" /></keybind>
</keyboard>
 <mouse><default /></mouse>
 <windowRules><windowRule identifier="*"><action name="SetDecorations"><decorations>full</decorations><forceSSD>yes</forceSSD></action></windowRule><windowRule identifier="kestrel-quick-settings"><action name="UnMaximize" /><action name="MoveToEdge" direction="right" /><action name="MoveToEdge" direction="down" /><action name="MoveRelative" x="-16" y="-16" /></windowRule><windowRule identifier="kestrel-launcher"><action name="MoveToEdge" direction="left" /><action name="MoveToEdge" direction="down" /><action name="MoveRelative" x="16" y="-16" /></windowRule></windowRules>
</labwc_config>
