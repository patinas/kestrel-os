<labwc_config>
 <core><decoration>server</decoration></core>
 <theme><name>Clearlooks-3.4</name><titleLayout>icon:iconify,max,close</titleLayout><showTitle>yes</showTitle></theme>
 <keyboard><default />
  <keybind key="W-Return"><action name="Execute" command="/usr/local/bin/kestrel-terminal" /></keybind>
  <keybind key="W-b"><action name="Execute" command="/usr/local/bin/kestrel-browser" /></keybind>
  <keybind key="A-F9"><action name="Iconify" /></keybind>
  <keybind key="A-F10"><action name="ToggleMaximize" /></keybind>
 </keyboard>
 <mouse><default /></mouse>
 <windowRules><windowRule identifier="*"><action name="Maximize" /><action name="SetDecorations"><decorations>full</decorations><forceSSD>yes</forceSSD></action></windowRule></windowRules>
</labwc_config>
