{
  "layer": "top",
  "position": "bottom",
  "height": 52,
  "modules-left": [
    "image#launcher"
  ],
  "modules-center": [
    "image#browser",
    "image#mail",
    "image#video",
    "wlr/taskbar"
  ],
  "modules-right": [
    "pulseaudio",
    "network",
    "battery",
    "clock"
  ],
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 26,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "icon-theme": [
      "hicolor",
      "Papirus"
    ],
    "app_ids-mapping": {
      "chrome": "google-chrome",
      "google-chrome": "google-chrome",
      "kestrel-quick-settings": "kestrel-quick-settings",
      "kestrel-launcher": "kestrel-launcher"
    },
    "ignore-list": [
      "kestrel-quick-settings",
      "kestrel-launcher"
    ]
  },
  "network": {
    "format-wifi": "Wi-Fi",
    "format-ethernet": "Wired",
    "format-disconnected": "Offline",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "kestrel-quick-settings"
  },
  "pulseaudio": {
    "format": "{volume}%",
    "format-muted": "Muted",
    "on-click": "kestrel-quick-settings"
  },
  "battery": {
    "format": "{capacity}%",
    "tooltip-format": "{status}"
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "Quick settings",
    "on-click": "kestrel-quick-settings"
  },
  "margin-bottom": 8,
  "margin-left": 12,
  "margin-right": 12,
  "image#browser": {
    "path": "/usr/share/icons/hicolor/64x64/apps/kestrel-browser.png",
    "size": 32,
    "on-click": "kestrel-browser"
  },
  "image#mail": {
    "path": "/usr/share/icons/hicolor/64x64/apps/kestrel-mail.png",
    "size": 32,
    "on-click": "kestrel-browser https://mail.google.com"
  },
  "image#video": {
    "path": "/usr/share/icons/hicolor/64x64/apps/kestrel-video.png",
    "size": 32,
    "on-click": "kestrel-browser https://www.youtube.com"
  },
  "image#launcher": {
    "path": "/usr/share/icons/hicolor/64x64/apps/kestrel-launcher.png",
    "size": 32,
    "on-click": "kestrel-launcher"
  }
}
