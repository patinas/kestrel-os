{
  "layer": "top",
  "position": "bottom",
  "height": 48,
  "modules-left": [
    "custom/launcher"
  ],
  "modules-center": [
    "custom/mail",
    "custom/video",
    "image#task0",
    "image#task1",
    "image#task2",
    "image#task3",
    "image#task4",
    "image#task5",
    "image#task6",
    "image#task7"
  ],
  "modules-right": [
    "pulseaudio",
    "network",
    "battery",
    "clock"
  ],
  "network": {
    "format-wifi": "Wi-Fi",
    "format-ethernet": "Wired",
    "format-disconnected": "Offline",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "kestrel-quick-settings"
  },
  "pulseaudio": {
    "format": "{volume}%",
    "format-muted": "Muted",
    "on-click": "kestrel-quick-settings"
  },
  "battery": {
    "format": "{capacity}%",
    "tooltip-format": "{status}"
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "Quick settings",
    "on-click": "kestrel-quick-settings"
  },
  "margin-bottom": 8,
  "margin-left": 8,
  "margin-right": 8,
  "custom/launcher": {
    "format": "\ue000",
    "tooltip-format": "Launcher",
    "on-click": "kestrel-launcher"
  },
  "custom/mail": {
    "format": "\ue002",
    "tooltip-format": "Mail",
    "on-click": "kestrel-browser https://mail.google.com"
  },
  "custom/video": {
    "format": "\ue003",
    "tooltip-format": "Video",
    "on-click": "kestrel-browser https://www.youtube.com"
  },
  "image#task0": {
    "exec": "kestrel-taskbar slot 0",
    "size": 48,
    "signal": 8,
    "interval": "once",
    "on-click": "kestrel-taskbar click 0",
    "tooltip": false
  },
  "image#task1": {
    "exec": "kestrel-taskbar slot 1",
    "size": 48,
    "signal": 8,
    "interval": "once",
    "on-click": "kestrel-taskbar click 1",
    "tooltip": false
  },
  "image#task2": {
    "exec": "kestrel-taskbar slot 2",
    "size": 48,
    "signal": 8,
    "interval": "once",
    "on-click": "kestrel-taskbar click 2",
    "tooltip": false
  },
  "image#task3": {
    "exec": "kestrel-taskbar slot 3",
    "size": 48,
    "signal": 8,
    "interval": "once",
    "on-click": "kestrel-taskbar click 3",
    "tooltip": false
  },
  "image#task4": {
    "exec": "kestrel-taskbar slot 4",
    "size": 48,
    "signal": 8,
    "interval": "once",
    "on-click": "kestrel-taskbar click 4",
    "tooltip": false
  },
  "image#task5": {
    "exec": "kestrel-taskbar slot 5",
    "size": 48,
    "signal": 8,
    "interval": "once",
    "on-click": "kestrel-taskbar click 5",
    "tooltip": false
  },
  "image#task6": {
    "exec": "kestrel-taskbar slot 6",
    "size": 48,
    "signal": 8,
    "interval": "once",
    "on-click": "kestrel-taskbar click 6",
    "tooltip": false
  },
  "image#task7": {
    "exec": "kestrel-taskbar slot 7",
    "size": 48,
    "signal": 8,
    "interval": "once",
    "on-click": "kestrel-taskbar click 7",
    "tooltip": false
  }
}
