Defaults:kestrel pam_service="kestrel-sudo", timestamp_timeout=0
# General enabled-mode rule must precede the narrow helper exception.
@include /var/lib/kestrel/sudoers
# Last matching rule wins: helpers remain noninteractive even when enabled.
kestrel ALL=(root) NOPASSWD: /usr/local/bin/kestrel-advanced-toggle enable, /usr/local/bin/kestrel-advanced-toggle disable
